<resources>
    <!-- Base application theme with DayEasy Logo 60-30-10 color scheme -->
    <style name="Base.Theme.WellnessTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary colors (60% - Deep Blue from logo) -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary colors (30% - Warm Orange from logo) -->
        <item name="colorSecondary">@color/secondary_30</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Accent colors (10% - Bright Yellow from logo) -->
        <item name="colorTertiary">@color/accent_10</item>
        <item name="colorTertiaryContainer">@color/accent_light</item>
        <item name="colorOnTertiary">@color/text_primary</item>

        <!-- Surface and background colors -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/primary_60</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <!-- Status bar with DayEasy deep blue -->
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.WellnessTracker" parent="Base.Theme.WellnessTracker" />

    <!-- Splash Screen Theme -->
    <style name="Theme.App.SplashScreen" parent="Theme.WellnessTracker">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>